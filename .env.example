# Copy this file to .env and fill in your values
# .env is gitignored — never commit real values

# Flask
SECRET_KEY=change-this-to-a-random-string

# SQLite database file location (relative to project root)
DATABASE_PATH=summer_os.db

# Ollama — local LLM server
# Run: ollama serve  (starts on port 11434 by default)
# Model already installed: qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Alpha Vantage — free market data (25 API calls/day on free tier)
# Register at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_key_here

# Program settings
SUMMER_START=2025-06-01
SUMMER_END=2025-08-31
STUDENT_NAME=YourSonsName
PARENT_PIN=1234

# Parent override settings
WEEKEND_XP_MINIMUM=400
GAMING_CAP_DAILY=4.0
